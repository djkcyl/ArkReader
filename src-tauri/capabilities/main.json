{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled application window can access native commands.",
  "windows": ["main"],
  "local": true,
  "remote": { "urls": ["http://arkreader.localhost/*", "arkreader://localhost/*"] },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "clipboard-manager:allow-write-text"
  ]
}
